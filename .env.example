# Required
TELEGRAM_BOT_TOKEN=your_token
TELEGRAM_USERID=your_numeric_id
HYPERLIQUID_TESTNET_WALLET=0x...
HYPERLIQUID_TESTNET_PRIVATE_KEY=...

# Trading
DRY_RUN=false                 # Set to false to execute real trades on Hyperliquid Testnet

# LLM (optional – if not set, advisors run in simulation mode)
LLM_PROVIDER=openai          # openai, anthropic, or none
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...

# Risk
RISK_PER_TRADE_PCT=0.5
DAILY_LOSS_LIMIT_PCT=5
MAX_POSITIONS=3

# Strategy toggles
ENABLE_FUNDING_ARB=false
ENABLE_TREND_FOLLOWING=true

# Logging
LOG_DIR=/app/data
